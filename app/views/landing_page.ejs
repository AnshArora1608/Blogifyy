<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Blogify</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

html{
scroll-behavior:smooth;
}

body{
background:#0b0b0b;
color:white;
overflow-x:hidden;
}

/* blob */

.blob{
position:fixed;
width:500px;
height:500px;
background:radial-gradient(circle,#ff2e63,transparent);
top:-200px;
left:-200px;
filter:blur(120px);
z-index:-1;
animation:moveBlob 20s infinite alternate;
}

@keyframes moveBlob{
to{
transform:translate(300px,200px);
}
}

/* NAVBAR */

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 6%;
position:fixed;
width:100%;
z-index:100;
background:rgba(0,0,0,0.4);
backdrop-filter:blur(10px);
transition:.4s;
}

nav.scrolled{
background:rgba(0,0,0,0.9);
}

.logo{
font-size:26px;
font-weight:700;
color:#ff2e63;
}

nav button{
background:#ff2e63;
border:none;
padding:10px 20px;
color:white;
border-radius:6px;
cursor:pointer;
transition:.3s;
}

nav button:hover{
background:#ff004c;
}

/* HERO */

.hero{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:120px 20px;
background:
linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,.9)),
url("https://images.unsplash.com/photo-1499750310107-5fef28a66643");
background-size:cover;
background-position:center;
}

.hero h1{
font-size:clamp(34px,6vw,64px);
margin-bottom:20px;
}

.hero p{
opacity:.8;
margin-bottom:30px;
}

.hero button{
padding:14px 28px;
font-size:17px;
background:#ff2e63;
border:none;
border-radius:30px;
color:white;
cursor:pointer;
}

.hero button:hover{
background:#ff004c;
}

/* FEATURES */

.features{
padding:100px 20px;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
gap:30px;
max-width:1200px;
margin:auto;
}

.card{
background:#181818;
padding:30px;
border-radius:10px;
transition:.6s;
}

.card:hover{
transform:translateY(-10px);
box-shadow:0 10px 30px rgba(255,0,100,.25);
}

/* TRENDING BLOGS */

.blog-slider{
padding:100px 20px;
max-width:1200px;
margin:auto;
}

.blog-slider h2{
margin-bottom:40px;
font-size:32px;
}

.slider{
display:flex;
gap:25px;
overflow-x:auto;
scroll-snap-type:x mandatory;
}

.slider::-webkit-scrollbar{
display:none;
}

.slide-card{
min-width:260px;
background:#181818;
padding:18px;
border-radius:10px;
scroll-snap-align:start;
transition:.4s;
}

.slide-card:hover{
transform:translateY(-8px);
}

.slide-card img{
width:100%;
height:150px;
object-fit:cover;
border-radius:8px;
margin-bottom:10px;
}

.slide-card button{
margin-top:10px;
padding:8px 16px;
background:#ff2e63;
border:none;
border-radius:20px;
color:white;
cursor:pointer;
}

/* WRITERS */

.writers{
padding:100px 20px;
text-align:center;
}

.writer-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:40px;
max-width:900px;
margin:auto;
}

.writer img{
width:100px;
height:100px;
border-radius:50%;
border:3px solid #ff2e63;
}

/* STATS */

.stats{
padding:100px 20px;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:40px;
text-align:center;
max-width:900px;
margin:auto;
}

.stat h1{
font-size:48px;
color:#ff2e63;
}

/* CTA */

.cta{
padding:100px 20px;
text-align:center;
}

.add-blog-btn{
margin-top:20px;
padding:14px 32px;
background:linear-gradient(135deg,#ff2e63,#ff004c);
border:none;
border-radius:40px;
color:white;
cursor:pointer;
}

/* FOOTER */

footer{
text-align:center;
padding:40px;
opacity:.6;
}

/* SCROLL REVEAL */

.reveal{
opacity:0;
transform:translateY(80px);
transition:1.5s ease;
}

.reveal.active{
opacity:1;
transform:translateY(0);
}

/* MODAL */

.modal{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.85);
display:flex;
align-items:center;
justify-content:center;
visibility:hidden;
opacity:0;
transition:.4s;
}

.modal.active{
visibility:visible;
opacity:1;
}

.form-box{
width:90%;
max-width:360px;
background:#1c1c1c;
padding:35px;
border-radius:10px;
}

.form-box input{
width:100%;
padding:10px;
margin:10px 0;
background:#111;
border:1px solid #444;
color:white;
border-radius:5px;
}

.form-box button{
width:100%;
padding:10px;
background:#ff2e63;
border:none;
color:white;
border-radius:5px;
cursor:pointer;
}

.toggle{
text-align:center;
margin-top:10px;
color:#ff2e63;
cursor:pointer;
}
.hero{
animation:heroFade 1.2s ease;
}

@keyframes heroFade{
from{
opacity:0;
transform:translateY(20px);
}
to{
opacity:1;
transform:translateY(0);
}
}

/* MOBILE */

@media(max-width:700px){
.blob{display:none;}
}

</style>
</head>

<body>

<div class="blob"></div>

<nav>
<div class="logo">Blogify</div>
<button onclick="openModal()">Sign In</button>
</nav>

<section class="hero">
<div>
<h1>Share Your Ideas With The World</h1>
<p>Write blogs, explore stories, and connect with creators globally.</p>
<button onclick="openModal()">Get Started</button>
</div>
</section>
<section class="features reveal">

<div class="card">
<h3>✍ Write Blogs</h3>
<p>Create powerful stories and share knowledge.</p>
</div>

<div class="card">
<h3>🌍 Discover Content</h3>
<p>Explore blogs worldwide.</p>
</div>

<div class="card">
<h3>❤️ Engage</h3>
<p>Connect with readers and writers.</p>
</div>

<div class="card">
<h3>📈 Grow Audience</h3>
<p>Build your personal brand.</p>
</div>

</section>

<section class="blog-slider reveal">

<h2>Trending Blogs</h2>

<div class="slider">

<div class="slide-card">
<img src="https://images.unsplash.com/photo-1518779578993-ec3579fee39f">
<h3>AI in 2026</h3>
<p>The future of artificial intelligence.</p>
<button onclick="openModal()">Read Blog</button>
</div>

<div class="slide-card">
<img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c">
<h3>Clean JavaScript</h3>
<p>Write better maintainable code.</p>
<button onclick="openModal()">Read Blog</button>
</div>

<div class="slide-card">
<img src="https://images.unsplash.com/photo-1504639725590-34d0984388bd">
<h3>Future Web</h3>
<p>Next generation internet trends.</p>
<button onclick="openModal()">Read Blog</button>
</div>

<div class="slide-card">
<img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085">
<h3>React Tips</h3>
<p>Improve your frontend workflow.</p>
<button onclick="openModal()">Read Blog</button>
</div>

<div class="slide-card">
<img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c">
<h3>Startup Stories</h3>
<p>Lessons from founders.</p>
<button onclick="openModal()">Read Blog</button>
</div>

</div>

</section>

<section class="writers reveal">

<h2>Top Writers</h2>

<div class="writer-grid">

<div class="writer">
<img src="https://randomuser.me/api/portraits/men/32.jpg">
<h4>David Clark</h4>
</div>

<div class="writer">
<img src="https://randomuser.me/api/portraits/women/44.jpg">
<h4>Emma Watson</h4>
</div>

<div class="writer">
<img src="https://randomuser.me/api/portraits/men/55.jpg">
<h4>Alex Chen</h4>
</div>

</div>

</section>

<section class="stats reveal">

<div class="stat">
<h1 class="counter" data-target="15000">0</h1>
<p>Blogs Published</p>
</div>

<div class="stat">
<h1 class="counter" data-target="8000">0</h1>
<p>Writers</p>
</div>

<div class="stat">
<h1 class="counter" data-target="120000">0</h1>
<p>Readers</p>
</div>

</section>

<section class="cta reveal">

<h1>Start Writing Today</h1>

<button class="add-blog-btn" onclick="openModal()">Add Blog</button>

</section>

<footer>
<p>© 2026 Blogify</p>
</footer>
<div class="modal" id="authModal">

<div class="form-box">

<!-- SIGN IN -->

<form id="signinForm" action="/signin" method="POST">

<h2>Sign In</h2>

<% if (typeof error !== "undefined") { %>
<p style="color:#ff4d4d;margin-bottom:10px;"><%= error %></p>
<% } %>

<input 
type="email"
name="email"
placeholder="Email"
required
>

<input
type="password"
name="password"
placeholder="Password"
required
>

<button type="submit">Sign In</button>

<div class="toggle" onclick="toggleForm()">Create account</div>

</form>


<!-- SIGN UP -->

<form id="signupForm" action="/signup" method="POST" style="display:none">

<h2>Sign Up</h2>

<input
type="text"
name="name"
placeholder="Name"
required
>

<input
type="email"
name="email"
placeholder="Email"
required
>

<input
type="password"
name="password"
placeholder="Password"
required
>

<button type="submit">Register</button>

<div class="toggle" onclick="toggleForm()">Already have account?</div>

</form>

</div>
</div>

</div>

</div>

<script>

function openModal(){
document.getElementById("authModal").classList.add("active")
}

function toggleForm(){
let signin=document.getElementById("signinForm")
let signup=document.getElementById("signupForm")

if(signin.style.display==="none"){
signin.style.display="block"
signup.style.display="none"
}else{
signin.style.display="none"
signup.style.display="block"
}
}

window.onclick=function(e){
if(e.target.id==="authModal"){
document.getElementById("authModal").classList.remove("active")
}
}

window.addEventListener("scroll",()=>{
document.querySelector("nav").classList.toggle("scrolled",window.scrollY>50)
})

const reveals=document.querySelectorAll(".reveal")

window.addEventListener("scroll",()=>{
reveals.forEach(el=>{
let windowHeight=window.innerHeight
let elementTop=el.getBoundingClientRect().top
if(elementTop<windowHeight-80){
el.classList.add("active")
}
})
})

document.querySelectorAll(".counter").forEach(counter=>{
let target=+counter.dataset.target
let count=0
let speed=target/300

function update(){
count+=speed
if(count<target){
counter.innerText=Math.floor(count)
requestAnimationFrame(update)
}else{
counter.innerText=target
}
}
update()
})
const backendError = "<%= typeof error !== 'undefined' ? error : '' %>"

if(backendError){
document.getElementById("authModal").classList.add("active")
}

</script>

</body>
</html>