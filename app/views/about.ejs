<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About | Blogify</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<%- include('./partial/head') %>
<style>

/* ─── RESET & BASE ─── */
*, *::before, *::after {
  margin: 0; padding: 0; box-sizing: border-box;
}

:root {
  --ink:    #0d1117;
  --cream:  #f0f4fb;
  --warm:   #e6ecf7;
  --accent: #3b6fd4;
  --accent2:#7aa3e8;
  --dark:   #0b1120;
  --mid:    #4a5a7a;
  --serif:  'Playfair Display', Georgia, serif;
  --sans:   'DM Sans', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background: var(--cream);
  color: var(--ink);
  font-family: var(--sans);
  overflow-x: hidden;
}

/* ─── NAV PLACEHOLDER ─── */
.nav-placeholder {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(240,244,251,0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(59,111,212,0.15);
  padding: 18px 60px;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: -0.5px;
}
.nav-links { display: flex; gap: 32px; }
.nav-links a {
  font-size: 14px;
  font-weight: 500;
  color: var(--mid);
  text-decoration: none;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--accent); }

.nav-user {
  display: flex; align-items: center; gap: 18px;
}
.nav-notif {
  position: relative;
  color: var(--mid);
  display: flex; align-items: center;
  transition: color 0.2s;
  text-decoration: none;
}
.nav-notif:hover { color: var(--accent); }
.notif-dot {
  position: absolute; top: -2px; right: -2px;
  width: 7px; height: 7px;
  background: var(--accent);
  border-radius: 50%;
  border: 1.5px solid var(--cream);
}
.nav-avatar {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 14px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  box-shadow: 0 0 0 2px rgba(59,111,212,0.25);
  transition: box-shadow 0.2s;
  user-select: none;
}
.nav-avatar:hover { box-shadow: 0 0 0 3px rgba(59,111,212,0.45); }

/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  padding: 120px 40px 80px;
  background: var(--dark);
}

.hero-bg {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 60% at 50% 0%, #1a2d5a 0%, #0d1830 50%, #080d1a 100%);
}

/* animated grain */
.hero-grain {
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.08'/%3E%3C/svg%3E");
  opacity: 0.4;
  pointer-events: none;
  animation: grain 0.5s steps(2) infinite;
}
@keyframes grain {
  0%   { transform: translate(0,0); }
  25%  { transform: translate(-1%,-1%); }
  50%  { transform: translate(1%,1%); }
  75%  { transform: translate(-1%,1%); }
  100% { transform: translate(1%,-1%); }
}

/* floating orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.18;
  animation: float 8s ease-in-out infinite;
  pointer-events: none;
}
.orb-1 { width: 500px; height: 500px; background: #2563eb; top: -150px; left: -100px; animation-delay: 0s; }
.orb-2 { width: 400px; height: 400px; background: #1e3a8a; bottom: -100px; right: -80px; animation-delay: -3s; }
.orb-3 { width: 300px; height: 300px; background: #60a5fa; top: 40%; left: 60%; animation-delay: -5s; }
@keyframes float {
  0%,100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-30px) scale(1.05); }
}

.hero-label {
  position: relative;
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 11px; font-weight: 500;
  letter-spacing: 3px; text-transform: uppercase;
  color: var(--accent2);
  margin-bottom: 28px;
  opacity: 0; animation: fadeUp 0.8s 0.2s forwards;
}
.hero-label::before, .hero-label::after {
  content: ''; display: block; width: 30px; height: 1px; background: var(--accent2); opacity: 0.5;
}

.hero-title {
  position: relative;
  font-family: var(--serif);
  font-size: clamp(52px, 10vw, 120px);
  font-weight: 900;
  line-height: 0.92;
  color: #fff;
  letter-spacing: -3px;
  margin-bottom: 12px;
  opacity: 0; animation: fadeUp 0.9s 0.4s forwards;
}
.hero-title em {
  font-style: italic;
  color: var(--accent);
  display: block;
}

.hero-rule {
  width: 60px; height: 2px;
  background: linear-gradient(90deg, var(--accent), transparent);
  margin: 30px auto;
  opacity: 0; animation: fadeUp 0.8s 0.6s forwards;
}

.hero-sub {
  position: relative;
  font-size: 18px; font-weight: 300;
  color: rgba(255,255,255,0.65);
  max-width: 560px;
  line-height: 1.75;
  opacity: 0; animation: fadeUp 0.9s 0.7s forwards;
}

.hero-cta {
  position: relative;
  margin-top: 48px;
  display: inline-flex; align-items: center; gap: 12px;
  background: var(--accent);
  color: #fff;
  padding: 16px 36px;
  border-radius: 3px;
  font-size: 14px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase;
  text-decoration: none;
  transition: all 0.3s;
  opacity: 0; animation: fadeUp 0.9s 0.9s forwards;
}
.hero-cta:hover {
  background: #2a55b0;
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(59,111,212,0.4);
}
.hero-cta svg { transition: transform 0.3s; }
.hero-cta:hover svg { transform: translateX(4px); }

.hero-scroll {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  opacity: 0; animation: fadeUp 1s 1.2s forwards;
}
.hero-scroll span {
  font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
  color: rgba(255,255,255,0.35);
}
.scroll-line {
  width: 1px; height: 50px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%,100% { opacity: 0.3; transform: scaleY(1); }
  50%      { opacity: 1;   transform: scaleY(1.1); }
}

/* ─── STATS BAND ─── */
.stats-band {
  background: var(--accent);
  padding: 50px 60px;
  display: flex; justify-content: center; flex-wrap: wrap; gap: 0;
}
.stat {
  flex: 1; min-width: 160px; max-width: 220px;
  text-align: center;
  padding: 20px 30px;
  position: relative;
}
.stat + .stat::before {
  content: '';
  position: absolute; left: 0; top: 25%; height: 50%;
  width: 1px;
  background: rgba(255,255,255,0.3);
}
.stat-num {
  font-family: var(--serif);
  font-size: 52px; font-weight: 900;
  color: #fff;
  line-height: 1;
  display: block;
}
.stat-label {
  font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  margin-top: 6px;
  display: block;
}

/* ─── SHARED LAYOUT ─── */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 60px;
}

section { padding: 100px 0; }

/* ─── SECTION LABEL ─── */
.section-label {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 500;
  letter-spacing: 3.5px; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 20px;
}
.section-label::before {
  content: ''; display: block; width: 24px; height: 1px; background: currentColor;
}

.section-title {
  font-family: var(--serif);
  font-size: clamp(36px, 5vw, 58px);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -1.5px;
  color: var(--ink);
}
.section-title em {
  font-style: italic;
  color: var(--accent);
}

/* ─── STORY ─── */
.story { background: var(--cream); }

.story-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  margin-top: 60px;
}

.story-text p {
  font-size: 17px;
  line-height: 1.85;
  color: var(--mid);
  margin-bottom: 22px;
}
.story-text p strong {
  color: var(--ink);
  font-weight: 500;
}

.story-image {
  position: relative;
}
.story-image-inner {
  border-radius: 4px;
  overflow: hidden;
  aspect-ratio: 4/5;
  background: linear-gradient(135deg, #0d1830, #1e3a8a, #2563eb);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.story-image-inner::before {
  content: '';
  position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.story-image-quote {
  position: absolute; bottom: -24px; left: -24px;
  background: var(--ink);
  color: #fff;
  padding: 28px 32px;
  max-width: 280px;
  border-radius: 4px;
  font-family: var(--serif);
  font-style: italic;
  font-size: 17px;
  line-height: 1.5;
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}
.story-image-quote cite {
  display: block;
  font-family: var(--sans);
  font-style: normal;
  font-size: 12px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--accent);
  margin-top: 10px;
}

/* ─── FEATURES ─── */
.features-section { background: var(--warm); }

.features-header {
  max-width: 620px;
  margin-bottom: 70px;
}
.features-header .section-title { margin-bottom: 20px; }
.features-header p {
  font-size: 17px;
  color: var(--mid);
  line-height: 1.7;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
}

.feat-card {
  background: var(--cream);
  padding: 48px 36px;
  position: relative;
  overflow: hidden;
  transition: background 0.35s;
  cursor: default;
}
.feat-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s;
}
.feat-card:hover { background: #fff; }
.feat-card:hover::before { transform: scaleX(1); }

.feat-icon {
  width: 48px; height: 48px;
  background: linear-gradient(135deg, var(--accent), #e8a55a);
  border-radius: 3px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 28px;
  font-size: 22px;
  transition: transform 0.3s;
}
.feat-card:hover .feat-icon { transform: scale(1.1) rotate(-3deg); }

.feat-num {
  position: absolute; top: 36px; right: 36px;
  font-family: var(--serif);
  font-size: 72px; font-weight: 900;
  color: rgba(0,0,0,0.04);
  line-height: 1;
  pointer-events: none;
  user-select: none;
}

.feat-card h4 {
  font-family: var(--serif);
  font-size: 22px; font-weight: 700;
  color: var(--ink);
  margin-bottom: 14px;
  line-height: 1.2;
}
.feat-card p {
  font-size: 15px;
  color: var(--mid);
  line-height: 1.7;
}

/* ─── BELIEFS ─── */
.beliefs-section { background: var(--cream); }

.beliefs-grid {
  display: grid;
  grid-template-columns: 5fr 4fr;
  gap: 80px;
  align-items: start;
  margin-top: 60px;
}

.beliefs-list { list-style: none; display: flex; flex-direction: column; gap: 0; }

.belief-item {
  display: flex;
  gap: 28px;
  padding: 32px 0;
  border-bottom: 1px solid rgba(0,0,0,0.07);
  align-items: flex-start;
  transition: all 0.3s;
  cursor: default;
}
.belief-item:hover .belief-num { color: var(--accent); }
.belief-item:hover { padding-left: 12px; }

.belief-num {
  font-family: var(--serif);
  font-size: 13px; font-weight: 700;
  color: rgba(0,0,0,0.18);
  transition: color 0.3s;
  flex-shrink: 0;
  padding-top: 3px;
  min-width: 28px;
}

.belief-content h4 {
  font-size: 17px; font-weight: 500;
  color: var(--ink);
  margin-bottom: 6px;
}
.belief-content p {
  font-size: 15px;
  color: var(--mid);
  line-height: 1.65;
}

.beliefs-visual {
  position: sticky; top: 100px;
}
.beliefs-card {
  background: var(--dark);
  border-radius: 4px;
  padding: 50px 42px;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.beliefs-card::before {
  content: '"';
  position: absolute;
  top: -40px; left: 24px;
  font-family: var(--serif);
  font-size: 220px; font-weight: 900;
  color: rgba(200,135,58,0.12);
  line-height: 1;
  pointer-events: none;
}
.beliefs-card-quote {
  font-family: var(--serif);
  font-size: 28px;
  font-style: italic;
  line-height: 1.45;
  margin-bottom: 24px;
  position: relative;
}
.beliefs-card-author {
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent);
}

.beliefs-img {
  margin-top: 24px;
  border-radius: 4px;
  overflow: hidden;
  aspect-ratio: 16/9;
  background: linear-gradient(135deg, #0d1830, #1a3a7a);
  display: flex; align-items: center; justify-content: center;
  font-size: 48px;
}

/* ─── TEAM ─── */
.team-section { background: var(--warm); }

.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  margin-top: 60px;
}

.team-card {
  position: relative;
  overflow: hidden;
  border-radius: 4px;
  background: var(--cream);
  transition: transform 0.35s, box-shadow 0.35s;
}
.team-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 30px 60px rgba(0,0,0,0.12);
}

.team-avatar {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #2c1a0a, var(--accent));
  display: flex; align-items: center; justify-content: center;
  font-size: 56px;
  overflow: hidden;
  position: relative;
}
.team-avatar::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.3), transparent);
}

.team-info { padding: 28px 28px 32px; }
.team-name {
  font-family: var(--serif);
  font-size: 22px; font-weight: 700;
  color: var(--ink);
  margin-bottom: 4px;
}
.team-role {
  font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 14px;
}
.team-bio {
  font-size: 14px;
  color: var(--mid);
  line-height: 1.65;
}

/* ─── NEWSLETTER ─── */
.newsletter {
  background: #080d1a;
  padding: 120px 60px;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.newsletter::before {
  content: 'BLOGIFY';
  position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
  font-family: var(--serif);
  font-size: clamp(100px, 22vw, 280px);
  font-weight: 900;
  color: rgba(255,255,255,0.025);
  white-space: nowrap;
  pointer-events: none;
  user-select: none;
}

.nl-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.12;
  pointer-events: none;
}
.nl-orb-1 { width: 500px; height: 500px; background: #2563eb; top: -200px; left: -150px; }
.nl-orb-2 { width: 400px; height: 400px; background: #1e3a8a; bottom: -150px; right: -100px; }

.nl-inner { position: relative; max-width: 620px; margin: 0 auto; }

.nl-label {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 500;
  letter-spacing: 3.5px; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 24px;
}
.nl-label::before, .nl-label::after {
  content: ''; display: block; width: 20px; height: 1px; background: currentColor;
}

.nl-title {
  font-family: var(--serif);
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -1.5px;
  margin-bottom: 20px;
}
.nl-title em { font-style: italic; color: var(--accent); display: block; }

.nl-sub {
  font-size: 17px;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
  margin-bottom: 50px;
}

.nl-form {
  display: flex; gap: 0; max-width: 480px; margin: 0 auto;
}

.nl-input-wrap { flex: 1; position: relative; }

.nl-input {
  width: 100%;
  padding: 20px 22px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-right: none;
  border-radius: 3px 0 0 3px;
  color: #fff;
  font-family: var(--sans);
  font-size: 15px;
  outline: none;
  transition: background 0.25s, border-color 0.25s;
}
.nl-input::placeholder { color: rgba(255,255,255,0.3); }
.nl-input:focus {
  background: rgba(255,255,255,0.12);
  border-color: rgba(200,135,58,0.4);
}

.nl-btn {
  padding: 20px 32px;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 0 3px 3px 0;
  font-family: var(--sans);
  font-size: 14px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.25s, transform 0.25s;
}
.nl-btn:hover {
  background: #2a55b0;
  transform: translateX(2px);
}

.nl-note {
  margin-top: 18px;
  font-size: 12px;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.5px;
}

/* ─── MEMBER CTA ─── */
.member-cta-row {
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap; gap: 14px;
  margin-bottom: 48px;
}

.member-btn {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 15px 28px;
  border-radius: 4px;
  font-family: var(--sans);
  font-size: 14px; font-weight: 500;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: all 0.25s;
}
.member-btn-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 20px rgba(59,111,212,0.35);
}
.member-btn-primary:hover {
  background: #2a55b0;
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(59,111,212,0.45);
}
.member-btn-secondary {
  background: rgba(255,255,255,0.08);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.14);
}
.member-btn-secondary:hover {
  background: rgba(255,255,255,0.14);
  transform: translateY(-2px);
}
.member-btn-ghost {
  color: var(--accent2);
  font-size: 14px;
  padding: 15px 10px;
  letter-spacing: 0.5px;
}
.member-btn-ghost:hover { color: #fff; }

.member-stats-row {
  display: flex; align-items: center; justify-content: center;
  gap: 0;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  padding: 28px 40px;
  flex-wrap: wrap;
}
.mem-stat {
  display: flex; flex-direction: column; align-items: center;
  padding: 0 36px;
}
.mem-stat-val {
  font-family: var(--serif);
  font-size: 36px; font-weight: 700;
  color: #fff;
  line-height: 1;
  margin-bottom: 6px;
}
.mem-stat-key {
  font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  color: rgba(255,255,255,0.4);
}
.mem-stat-divider {
