<script>
// ─── SCROLL REVEAL ───
const reveals = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); } });
}, { threshold: 0.12 });
reveals.forEach(el => observer.observe(el));

// ─── COUNTER ───
const counters = document.querySelectorAll('.count-animated');
let countersStarted = false;

function startCounters() {
  if (countersStarted) return;
  countersStarted = true;
  counters.forEach(counter => {
    const target = +counter.dataset.target;
    const duration = 1600;
    const step = target / (duration / 16);
    let current = 0;
    const timer = setInterval(() => {
      current += step;
      if (current >= target) { current = target; clearInterval(timer); }
      counter.textContent = Math.floor(current);
    }, 16);
  });
}

const statsObserver = new IntersectionObserver((entries) => {
  if (entries[0].isIntersecting) startCounters();
}, { threshold: 0.5 });
document.querySelector('.stats-band') && statsObserver.observe(document.querySelector('.stats-band'));

// ─── SMOOTH SCROLL ───
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });
});

// ─── NAV SHRINK ON SCROLL ───
const nav = document.querySelector('.nav-placeholder');
window.addEventListener('scroll', () => {
  nav.style.padding = window.scrollY > 40 ? '12px 60px' : '18px 60px';
  nav.style.transition = 'padding 0.3s';
});

// ─── NEWSLETTER SUBMIT ───
document.querySelector('.nl-btn').addEventListener('click', function() {
  const input = document.querySelector('.nl-input');
  if (input.value.includes('@')) {
    this.textContent = '✓ Subscribed!';
    this.style.background = '#2ecc71';
    input.value = '';
    setTimeout(() => { this.textContent = 'Get Access'; this.style.background = ''; }, 3000);
  } else {
    input.style.borderColor = 'rgba(231,76,60,0.5)';
    setTimeout(() => { input.style.borderColor = ''; }, 1500);
  }
});
</script>

