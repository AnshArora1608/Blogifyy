<script>
(function () {

  /* ── User dropdown ── */
  const userEl    = document.getElementById('bfyUser');
  const trigger   = document.getElementById('bfyUserTrigger');

  trigger.addEventListener('click', function (e) {
    e.stopPropagation();
    userEl.classList.toggle('open');
  });

  document.addEventListener('click', function (e) {
    if (!userEl.contains(e.target)) userEl.classList.remove('open');
  });

  /* ── Mobile toggle ── */
  const toggler = document.getElementById('bfyToggler');
  const mobile  = document.getElementById('bfyMobile');

  toggler.addEventListener('click', function () {
    toggler.classList.toggle('open');
    mobile.classList.toggle('open');
  });

  /* ── Scroll: deepen background ── */
  const nav = document.querySelector('.bfy-nav');
  window.addEventListener('scroll', function () {
    if (window.scrollY > 10) {
      nav.style.background = 'linear-gradient(90deg, rgba(7,17,31,0.99) 0%, rgba(10,22,42,0.99) 100%)';
      nav.style.boxShadow  = '0 4px 24px rgba(0,0,0,0.4)';
    } else {
      nav.style.background = 'linear-gradient(90deg, rgba(7,17,31,0.97) 0%, rgba(10,22,42,0.97) 100%)';
      nav.style.boxShadow  = 'none';
    }
  }, { passive: true });

})();
</script>
