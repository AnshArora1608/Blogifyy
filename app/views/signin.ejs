<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign In</title>

<%- include('./partial/head') %>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family: "Inter", sans-serif;
}

body{
height:100vh;
display:flex;
align-items:center;
justify-content:center;
background:url("/images/bg.jpg");
background-size:cover;
background-position:center;
overflow:hidden;
}

/* dark overlay */

body::before{
content:"";
position:absolute;
width:100%;
height:100%;
background:rgba(0,0,0,0.55);
backdrop-filter: blur(4px);
}

/* login card */

form{
position:relative;
width:400px;
padding:45px;
border-radius:18px;
background:rgba(255,255,255,0.15);
backdrop-filter: blur(18px);
box-shadow:0 20px 60px rgba(0,0,0,0.45);
display:flex;
flex-direction:column;
gap:25px;
animation:fadeIn .7s ease;
}

@keyframes fadeIn{
from{
opacity:0;
transform:translateY(30px);
}
to{
opacity:1;
transform:translateY(0);
}
}

form h1{
text-align:center;
color:white;
font-weight:700;
}

/* input container */

.box{
width:100%;
position:relative;
}

.form-control{
background:rgba(255,255,255,0.9);
border:none;
border-radius:10px;
padding:14px;
font-size:15px;
}

.form-control:focus{
box-shadow:0 0 0 3px #2563eb33;
}

/* icon inside input */

.input-icon{
position:absolute;
top:50%;
left:12px;
transform:translateY(-50%);
width:18px;
opacity:.7;
}

.form-control{
padding-left:38px;
}

/* show password icon */

.toggle-pass{
position:absolute;
right:12px;
top:50%;
transform:translateY(-50%);
cursor:pointer;
font-size:14px;
color:#555;
}

/* button */

button{
width:100%;
padding:13px;
border:none;
border-radius:10px;
font-weight:600;
font-size:16px;
color:white;
background:linear-gradient(135deg,#2563eb,#4f46e5);
transition:all .3s ease;
position:relative;
}

button:hover{
transform:translateY(-2px);
box-shadow:0 10px 25px rgba(0,0,0,0.3);
}

/* loading spinner */

button.loading{
pointer-events:none;
opacity:.8;
}

button.loading::after{
content:"";
width:18px;
height:18px;
border:3px solid white;
border-top-color:transparent;
border-radius:50%;
position:absolute;
right:15px;
top:50%;
transform:translateY(-50%);
animation:spin .7s linear infinite;
}

@keyframes spin{
to{ transform:translateY(-50%) rotate(360deg); }
}

/* bottom text */

.signup{
text-align:center;
color:white;
font-size:14px;
}

.signup a{
color:#60a5fa;
text-decoration:none;
font-weight:600;
}

.signup a:hover{
text-decoration:underline;
}

/* responsive */

@media(max-width:500px){

form{
width:90%;
padding:35px;
}

}

</style>
</head>

<body>

<form action="/user/signin" method="post" id="loginForm">

<h1>Sign In</h1>

<div class="box">

<img src="/images/emailicon.jpg" class="input-icon">

<input
type="email"
class="form-control"
placeholder="Email Address"
name="email"
required>

</div>

<div class="box">

<img src="/images/pass.jpeg" class="input-icon">

<input
type="password"
class="form-control"
placeholder="Password"
name="password"
id="password"
required>

<span class="toggle-pass" onclick="togglePassword()">Show</span>

</div>

<button type="submit" id="loginBtn">
Sign In
</button>

<div class="signup">
<span>Don't have an account?</span>
<a href="/user/signup">Sign Up</a>
</div>

</form>

<%- include('./partial/script') %>

<script>

/* show / hide password */

function togglePassword(){

const pass = document.getElementById("password")

if(pass.type === "password"){
pass.type="text"
}else{
pass.type="password"
}

}

/* loading animation */

document.getElementById("loginForm").addEventListener("submit",function(){

const btn=document.getElementById("loginBtn")

btn.classList.add("loading")

})

</script>

</body>

</html>